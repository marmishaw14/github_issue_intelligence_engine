{
    "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
  
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
  
      "resolveJsonModule": true,
      "isolatedModules": true,
  
      "types": ["node"],
  
      "baseUrl": ".",
      "paths": {
        "@/*": ["./src/*"]
      },
  
      "outDir": "dist"
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
  }